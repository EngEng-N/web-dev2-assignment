<%- include("templates/header") %>
<form action="/signupSubmit" method="POST" class="row g-3">
    <div class="mb-3">
        <label for="staticEmail2" class="col-form-label">Username</label>
        <input type="text" name="username" class="form-control" id="staticEmail2" placeholder="Enter your username" required>
    </div>
    <div class="mb-3">
        <label for="staticEmail2" class="col-form-label">Email</label>
        <input type="email" class="form-control" id="exampleFormControlInput1" name="email" placeholder="name@example.com" required>
    </div>
    <div class="mb-3">
        <label for="inputPassword2" class="col-form-label">Password</label>
        <input type="password" class="form-control" id="inputPassword2" name="password"placeholder="Password">
    </div>
    <div class="mb-3">
        <button type="submit" class="btn btn-primary mb-3">Sign Up</button>
    </div>
</form>
<%- include("templates/footer") %>