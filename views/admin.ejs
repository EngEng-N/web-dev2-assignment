<%- include("templates/header") %>
  <h1>Users</h1>
  <ul>
    <% for (let i = 0; i < users.length; i++) { %>
        <li>
            <%= users[i].username %> - <%= users[i].user_type %>
            <a href="/promote/<%= users[i].email %>" class="btn btn-danger btn-sm">Promote to Admin</a>
            <a href="/demote/<%= users[i].email %>" class="btn btn-warning btn-sm">Demote to User</a>
        </li>
    <% } %>
  </ul>
<%- include("templates/footer") %>